# Neon pooled connection string (host contains -pooler). The unpooled URL is derived in code.
DATABASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_CHAT=claude-sonnet-5
# Resend
RESEND_API_KEY=
EMAIL_FROM=
# Protects the Vercel Cron route that runs agents
CRON_SECRET=
# Optional: base URL for links in emails. On Vercel it is derived from the production URL when unset.
APP_URL=http://localhost:3000
TZ_DEFAULT=Asia/Jakarta
